(defun c:testreal ()
    (setq pt (list 0.0 0.0 0.0))
    (setq cen (list (+ (car pt) -50.0000) (+ (cadr pt) -120.0000)))
    (setq res (entmake (list '(0 . "ARC")
                             '(8 . "0")
                             (cons 10 cen)
                             (cons 40 9.5250)
                             (cons 50 0.0000)
                             (cons 51 3.14159265))))
    (if res (princ "\nSuccess: Created testreal") (princ "\nFailed: testreal returned nil"))
    (princ)
)


