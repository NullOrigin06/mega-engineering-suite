(defun c:test2d_0_180 ()
    (setq cen (list 0.0 0.0))
    (setq res (entmake (list '(0 . "ARC") (cons 10 cen) (cons 40 10.0) (cons 50 0.0) (cons 51 3.14159265))))
    (if res (princ "\nSuccess: Created 2D 0->180") (princ "\nFailed: 2D 0->180 returned nil"))
    (princ)
)

